# Copy to .env and fill in. NEVER commit the real .env.

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Path to a service-account JSON with Vertex AI User role (local dev only)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Models
GEMINI_MODEL=gemini-2.5-flash
MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
TEXT_EMBEDDING_MODEL=gemini-embedding-001

# --- ClickHouse Cloud (partner) ---
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=reelvault
CLICKHOUSE_SECURE=true
