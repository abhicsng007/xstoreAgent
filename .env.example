# Copy to .env and fill in. NEVER commit the real .env.

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini generation location. Gemini 3.x Flash is served from "global".
GOOGLE_CLOUD_LOCATION=global
# Embeddings need a REGIONAL endpoint (not served from "global").
EMBEDDING_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Preferred: `gcloud auth application-default login` (ADC) and leave this blank.
# Alternatively point it at a service-account JSON with the Vertex AI User role.
GOOGLE_APPLICATION_CREDENTIALS=

# Models
GEMINI_MODEL=gemini-3.7-flash
MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
TEXT_EMBEDDING_MODEL=gemini-embedding-001

# --- ClickHouse Cloud (partner) ---
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=xstoreAgent
CLICKHOUSE_SECURE=true
# Official mcp-clickhouse at runtime (ClickHouse track requirement). Keep true.
USE_CLICKHOUSE_MCP=true
# Multi-agent Librarian (root + Analyst/Archivist/Scout/Curator/Editor sub-agents).
# Keep true; set false to fall back to the single-agent Librarian.
USE_MULTI_AGENT=true
# Optional override; defaults to ./sample_assets or /app/sample_assets in the image.
SAMPLE_ASSETS_DIR=

# Optional. Free key at https://www.pexels.com/api/ — `scripts/fetch_demo_pack.py`
# prefers Pexels when this is set, otherwise Mixkit (no key).
PEXELS_API_KEY=
